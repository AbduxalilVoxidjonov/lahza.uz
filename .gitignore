# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/

# Node / UI
node_modules/
app/dist/

# Rust / Tauri
app/src-tauri/target/
app/src-tauri/gen/
app/src-tauri/binaries/*
!app/src-tauri/binaries/.gitkeep
app/src-tauri/resources/bin/*
!app/src-tauri/resources/bin/.gitkeep

# Baholash ma'lumotlari (audio/video repozitoriyga kirmaydi)
eval/data/**
!eval/data/.gitkeep
eval/results/**
!eval/results/.gitkeep

# Maxfiy kalitlar
*.key
.env

# Lokal relizlar: matn fayllari git'da, binarlar yo'q (versiyalar/README.md)
versiyalar/*/*.app/
versiyalar/*/*.zip
versiyalar/*/*.dmg
