{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lahza Studio",
  "version": "0.2.4",
  "identifier": "uz.lahza.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lahza Studio",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Video",
    "shortDescription": "Oflayn AI Reels kesuvchi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lahza-engine"],
    "resources": {
      "../../build/sidecar/catalog/": "catalog/",
      "resources/bin/": "bin/",
      "../../LICENSES-THIRD-PARTY.md": "LICENSES-THIRD-PARTY.md"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
