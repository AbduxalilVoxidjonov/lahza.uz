{
  "manifestVersion": 5,
  "id": "uz.lahza.premiere",
  "name": "Lahza",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": { "domains": ["http://127.0.0.1", "http://127.0.0.1:47600", "http://127.0.0.1:47601", "http://127.0.0.1:47602"] }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "lahzaPanel",
      "label": { "default": "Lahza", "uz": "Lahza" },
      "minimumSize": { "width": 300, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 680 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/dark.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium"] },
        { "width": 23, "height": 23, "path": "icons/light.svg", "scale": [1, 2], "theme": ["lightest", "light"] }
      ]
    }
  ],
  "icons": [
    { "width": 48, "height": 48, "path": "icons/plugin-icon.svg", "scale": [1, 2], "theme": ["darkest", "dark", "medium", "lightest", "light", "all"], "species": ["pluginList"] }
  ]
}
