<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  Lahza Studio — After Effects CEP paneli.
  Manba: Adobe-CEP/CEP-Resources, CEP_12.x/Samples/CEP_HTML_Test_Extension-12.0/CSXS/manifest.xml
  (ExtensionManifest Version="12.0", RequiredRuntime CSXS 12.0) va CEP 12 HTML Extension Cookbook
  (AEFT: CEP 12 = After Effects 25.0; versiya oralig'i "[min,max]" sintaksisi).
-->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   ExtensionBundleId="uz.lahza.ae"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Lahza"
                   Version="12.0">
  <ExtensionList>
    <Extension Id="uz.lahza.ae.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- CEP 12 After Effects 25.0 dan (Cookbook jadvali). Yuqori chegara ochiq qoldirilgan. -->
      <Host Name="AEFT" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="uz.lahza.ae.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node faqat engine.json (port/token) ni o'qish uchun; yo'q bo'lsa panel qo'lda kiritishni so'raydi. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Lahza</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>280</Width>
            </MinSize>
            <MaxSize>
              <Height>2000</Height>
              <Width>1200</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
