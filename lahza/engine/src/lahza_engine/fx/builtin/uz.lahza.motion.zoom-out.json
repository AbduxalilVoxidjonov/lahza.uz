{
  "schema": "lahza.fx/1",
  "id": "uz.lahza.motion.zoom-out",
  "version": "1.0.0",
  "kind": "motion",
  "name": {
    "uz": "Uzoqlashish",
    "uz-Cyrl": "Узоқлашиш",
    "ru": "Отъезд",
    "en": "Zoom out"
  },
  "description": {
    "uz": "Yaqin kadrdan sekin uzoqlashish (zoom → 1)",
    "uz-Cyrl": "Яқин кадрдан секин узоқлашиш (zoom → 1)",
    "ru": "Плавный отъезд (zoom → 1)",
    "en": "Slow zoom out (zoom → 1)"
  },
  "backend": "motion-keys",
  "preset": "zoom-out",
  "params": [
    {
      "id": "zoom",
      "type": "float",
      "min": 1.0,
      "max": 1.6,
      "default": 1.15
    },
    {
      "id": "easing",
      "type": "enum",
      "values": [
        "linear",
        "ease-out",
        "expo-out"
      ],
      "default": "ease-out"
    }
  ],
  "default_trigger": "on_start",
  "license": "Lahza"
}
